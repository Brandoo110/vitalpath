DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/vitalpath?schema=public"

# Production runtime only: paste the complete Supabase root CA PEM, preserving
# its multiple lines. Leave empty for local development.
DATABASE_SSL_CA=""

# Runtime DATABASE_URL must not include sslmode, sslrootcert, sslcert, sslkey,
# ssl, or sslnegotiation when DATABASE_SSL_CA is configured; the application
# supplies verified TLS.

# Migration-only direct connection. Keep it separate from DATABASE_URL and use
# sslmode=verify-full with an sslrootcert path, for example:
# DIRECT_URL="postgresql://USER:PASSWORD@db.example.supabase.co:5432/vitalpath?schema=public&sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-root-ca.pem"
DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/vitalpath?schema=public"
